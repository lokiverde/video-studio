  "artifact_words": ["film grain", "grain", "red-eye", "vignette", "motion blur", "rolling-shutter", "rolling shutter", "mpeg", "jpeg", "blocking", "macroblock", "compression", "interlacing", "scanline", "color bleed", "bleeding color", "crushed black", "beauty processing", "sharpening halo", "hdr", "smudge", "lens flare", "barrel distortion", "color fringing", "chromatic aberration", "sensor noise", "digital noise", "noise reduction"],
