  "real_people": ["barack obama", "beyonce", "bill gates", "dario amodei", "donald trump", "elon musk", "gavin newsom", "jeff bezos", "jensen huang", "joe biden", "joe rogan", "kamala harris", "kim kardashian", "mark zuckerberg", "mrbeast", "oprah", "sam altman", "satya nadella", "steve jobs", "sundar pichai", "taylor swift", "tim cook", "warren buffett"],
