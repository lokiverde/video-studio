  "short_clip_seconds": 10,
  "max_beats_short_clip": 5,
  "montage_shot_pattern": "shot\\s+\\d+\\s*\\|\\s*([\\d.]+)\\s*-\\s*([\\d.]+)\\s*s",
  "montage_min_shot_seconds": 1.0,
  "flux_providers": ["flux"],
  "flux_max_negations": 0,
  "guarded_lanes": ["example-realty"],
