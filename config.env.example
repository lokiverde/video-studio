# Video Studio config. Copy to config.env and fill in. config.env is gitignored.

# Media server (media-service/service.py on your GPU box). Serves /image (FLUX through
# ComfyUI), /tts (kokoro | chatterbox), /health. Same machine: leave as is.
TIM_MEDIA_URL=http://127.0.0.1:8189

# Optional OpenAI-compatible LLM (vLLM, Ollama, LM Studio) that write_script.py uses when
# no LLM caller (Claude Code) has written scenes.json itself.
TIM_LLM_URL=http://127.0.0.1:8000

# BunnyCDN storage for final videos and preview images. Leave the key blank to keep
# everything local in jobs/<id>/out/.
# PUT ${BUNNY_STORAGE_BASE}/<path> with an AccessKey header, public at ${BUNNY_PUBLIC_BASE}/<path>
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_BASE=https://la.storage.bunnycdn.com/your-zone
BUNNY_PUBLIC_BASE=https://your-zone.b-cdn.net

# Optional cloud TTS fallback (fish.audio). Leave blank to stay fully local.
FISH_API_KEY=
FISH_MODEL=s2.1-pro
FISH_VOICE_STOCK=
FISH_VOICE_TONY=

# Optional line appended to every YouTube description in out/youtube.md
# (brand line, license disclosure, site link). Leave blank for none.
YOUTUBE_FOOTER=

# Rewords the line every video with realistic AI footage gets in its YouTube description.
# Blank uses "This video contains AI-generated footage." The disclosure cannot be turned off.
AI_DISCLOSURE_LINE=

# Folder holding the node and npx that render motion graphics (scripts/mograph.py), for a
# machine whose Node is not on PATH. Blank uses whatever npx is on PATH.
NODE_DIR=

# fv.py publish (optional): blotato.com > Settings > API key. Fill in your own account ids
# in assets/publish/channels.json first (fv.py blotato-accounts lists them).
BLOTATO_API_KEY=
TECHTONY_FOOTER=
