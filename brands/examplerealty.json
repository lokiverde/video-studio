    "bold": "assets/fonts/DejaVuSans-Bold.ttf",
    "semibold": "assets/fonts/DejaVuSans-Bold.ttf",
    "regular": "assets/fonts/DejaVuSans-Bold.ttf",
    "light": "assets/fonts/DejaVuSans-Bold.ttf"
  },
  "logo_white": "assets/brand/examplerealty/logo-white.png",
  "logo_blue": "assets/brand/examplerealty/logo-blue.png",
  "team_photo": "assets/brand/examplerealty/team.jpg",
  "placard": {
    "headline": "Contact Your Team",
    "contacts": [
      {
        "name": "Agent One",
        "title": "Broker Associate",
