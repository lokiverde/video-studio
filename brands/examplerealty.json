  "loudness": -14,
  "pop": {
    "landscape": {
      "target_seconds": 72,
      "map_beats": 8,
      "clip_beats": 2,
      "open_beats": 8,
      "card_seconds": 5.5,
      "tour_beats": 4
    },
    "portrait": {
      "target_seconds": 33,
      "map_beats": 6,
      "clip_beats": 2,
      "open_beats": 8,
      "card_seconds": 4.5,
      "tour_beats": 3
    }
  }
